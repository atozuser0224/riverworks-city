# Keep this file as a template. Put the real key only in Server/.env.
OPENROUTER_API_KEY=

# The only currently price-verified model.
OPENROUTER_MODEL=google/gemini-2.5-flash-lite

# Localhost is the safe default. A non-loopback host also requires
# RIVERWORKS_GATEWAY_TOKEN and every client request must use it as a Bearer token.
RIVERWORKS_GATEWAY_HOST=127.0.0.1
RIVERWORKS_GATEWAY_PORT=47841
RIVERWORKS_GATEWAY_TOKEN=

# These may be lowered, but cannot exceed the built-in safety ceilings.
RIVERWORKS_RATE_PER_MINUTE=2
RIVERWORKS_MAX_USD_PER_HOUR=0.5
RIVERWORKS_MAX_USD_PER_DAY=2
RIVERWORKS_UPSTREAM_TIMEOUT_MS=30000
